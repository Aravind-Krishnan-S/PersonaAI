<Page
    x:Class="CharacterChat.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CharacterChat.Models"
    xmlns:viewmodels="using:CharacterChat.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Persona Metadata -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{x:Bind ViewModel.CurrentCharacter.Name, Mode=OneWay}" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Roleplay Session" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.5" />
        </StackPanel>

        <!-- Chat History -->
        <ListView x:Name="ChatList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="0,0,0,12">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,4">
                        <Border Style="{StaticResource CharacterBubbleBorderStyle}"
                                Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=assistant}">
                            <TextBlock Text="{x:Bind Content, Mode=OneWay}" Foreground="White" />
                        </Border>
                        
                        <!-- User Message Bubble (Right) -->
                        <Border Style="{StaticResource UserBubbleBorderStyle}"
                                Visibility="{Binding Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=user}">
                            <TextBlock Text="{x:Bind Content, Mode=OneWay}" Foreground="White" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,12,0,0">
            <TextBox PlaceholderText="Ask your character something..."
                     Text="{x:Bind ViewModel.UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     CornerRadius="8" />
            <Button Grid.Column="1" 
                    Content="Send"
                    Command="{x:Bind ViewModel.SendMessageCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    CornerRadius="8" />
        </Grid>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsTyping, Mode=OneWay}" 
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,0,0"
                      Width="20" Height="20" />
    </Grid>
</Page>
